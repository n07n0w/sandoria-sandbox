{
  "name": "mysandbox",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "start": "node ./bin/www",
    "db:init": "node init-db.js",
    "test": "node --test tests/*.test.js",
    "test:quick": "node --check app.js && node --check bin/www",
    "lint": "eslint . --ext .js --max-warnings 0 || true",
    "lint:check": "eslint . --ext .js --format compact || echo 'Linting issues found (non-blocking)'",
    "validate": "npm run test:quick && npm run lint:check"
  },
  "dependencies": {
    "@sentry/node": "^10.31.0",
    "@sentry/tracing": "^7.120.4",
    "archiver": "^7.0.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "~4.16.1",
    "express-session": "^1.18.1",
    "http-errors": "~1.6.3",
    "konva": "^9.3.16",
    "morgan": "~1.9.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "peer": "^1.0.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "pug": "2.0.0-beta11",
    "uuid": "^11.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-unused-imports": "^4.3.0"
  }
}
