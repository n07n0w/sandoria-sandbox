{
  "env": {
    "node": true,
    "es2021": true,
    "browser": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-unreachable": "error",
    "no-constant-condition": "warn",
    "no-empty": "warn",
    "semi": ["warn", "always"],
    "quotes": [
      "warn",
      "single",
      { "avoidEscape": true, "allowTemplateLiterals": true }
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    "public/javascripts/jquery*.js",
    "public/javascripts/konva*.js",
    "public/javascripts/peerjs*.js",
    "nginx/",
    "*.min.js"
  ],
  "globals": {
    "Konva": "readonly",
    "$": "readonly",
    "jQuery": "readonly",
    "WebSocket": "readonly",
    "RTCPeerConnection": "readonly",
    "RTCSessionDescription": "readonly",
    "RTCIceCandidate": "readonly",
    "crypto": "readonly",
    "startP2PConnection": "readonly",
    "startP2PConnectionAsync": "readonly"
  }
}
